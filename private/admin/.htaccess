# Permitir acesso à área administrativa
# Este arquivo garante que o admin seja acessível via web

# Desabilitar listagem de diretórios por segurança
Options -Indexes

# Permitir acesso aos arquivos PHP
<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

# Redirecionar para login se tentar acessar diretório sem arquivo
DirectoryIndex index.php login.php

# Configurações de segurança
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>